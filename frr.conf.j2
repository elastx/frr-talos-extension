ip route 0.0.0.0/0 null0 vrf metallb
ipv6 route ::/0 null0 vrf metallb
!
router bgp {{ ASN_METALLB_LOCAL }} vrf {{ NAMESPACE_METALLB }}
  bgp router-id {{ PEER_IP_LOCAL }}
  no bgp ebgp-requires-policy
  no bgp default ipv4-unicast
  bgp allow-martian-nexthop
  neighbor METALLB peer-group
  neighbor METALLB remote-as {{ ASN_METALLB_REMOTE }}
  neighbor METALLB passive
  !
  address-family ipv4 unicast
  {% if neighbours.ipv4 is defined %}
    neighbor {{ PEER_IP_REMOTE }} peer-group METALLB
    neighbor {{ PEER_IP_REMOTE }} activate
  {% endif %}
    neighbor METALLB route-map denymap out
    neighbor {{ PEER_IP_REMOTE1 }} remote-as {{ ASN_LOCAL }}
    neighbor {{ PEER_IP_REMOTE1 }} activate
    neighbor {{ PEER_IP_REMOTE1 }} route-map denydefault in
  exit-address-family
  !
  address-family ipv6 unicast
  {% if neighbours.ipv6 is defined %}
    neighbor {{ PEER_IPV6_REMOTE }} peer-group METALLB
    neighbor {{ PEER_IPV6_REMOTE }} activate
  {% endif %}
    neighbor METALLB route-map denymap_v6 out
    neighbor {{ PEER_IPV6_REMOTE1 }} remote-as {{ ASN_LOCAL }}
    neighbor {{ PEER_IPV6_REMOTE1 }} activate
    neighbor {{ PEER_IPV6_REMOTE1 }} route-map denydefault_v6 in
  exit-address-family
  !
router bgp {{ ASN_LOCAL }}
  bgp router-id {{ NODE_IP }}
  no bgp ebgp-requires-policy
  no bgp default ipv4-unicast
  bgp bestpath as-path multipath-relax
  #bgp allow-martian-nexthop
  neighbor FABRIC peer-group
  neighbor FABRIC remote-as 48579
  neighbor FABRIC timers 1 3
  {% if not "no" in NEIGHBOR_PASSWORD %}
  neighbor FABRIC password {{ NEIGHBOR_PASSWORD }}
  {% endif %}
  !
  address-family ipv4 unicast
  {% if neighbours.ipv4 is defined %}
  {% for n in neighbours.ipv4 %}
    neighbor {{ n }} peer-group FABRIC
    #neighbor {{ n }} route-map SETSRC out
    neighbor {{ n }} activate
  {% endfor %}
  {% endif %}
    neighbor {{ PEER_IP_LOCAL1 }} remote-as {{ ASN_METALLB_LOCAL }}
    neighbor {{ PEER_IP_LOCAL1 }} route-map denydefault in
    neighbor {{ PEER_IP_LOCAL1 }} activate
    redistribute connected route-map loopbacks
    #import vrf {{ NAMESPACE_METALLB }}
  exit-address-family
  !
  address-family ipv6 unicast
  {% if neighbours.ipv6 is defined %}
  {% for n in neighbours.ipv6 %}
    neighbor {{ n }} peer-group FABRIC
    #neighbor {{ n }} route-map SETSRC_V6 out
    neighbor {{ n }} activate
  {% endfor %}
  {% endif %}
    neighbor {{ PEER_IPV6_LOCAL1 }} remote-as {{ ASN_METALLB_LOCAL }}
    neighbor {{ PEER_IPV6_LOCAL1 }} route-map denydefault_v6 in
    neighbor {{ PEER_IPV6_LOCAL1 }} activate
    redistribute connected route-map loopbacks
    #import vrf {{ NAMESPACE_METALLB }}
  exit-address-family
!
ip prefix-list denyall seq 10 deny 0.0.0.0/0
!
ip prefix-list default seq 10 permit 0.0.0.0/0
!
ipv6 prefix-list denyall_v6 seq 10 deny ::/0
!
ip prefix-list default_v6 seq 10 permit ::/0
!
route-map denydefault deny 1
  match ip address prefix-list default
!
route-map denydefault permit 10
!
route-map denydefault_v6 deny 1
  match ip address prefix-list default_v6
!
route-map denydefault_v6 permit 10
!
route-map denymap permit 1
  match ip address prefix-list denyall
!
route-map denymap_v6 permit 1
  match ipv6 address prefix-list denyall_v6
!
route-map SETSRC permit 10
  set src {{ NODE_IP }}
!
route-map SETSRC_V6 permit 10
  set src {{ NODE_IPV6 }}
!
route-map loopbacks permit 10
  match interface lo
!
ip protocol bgp route-map SETSRC
ipv6 protocol bgp route-map SETSRC_V6
!
line vty
!
#ip nht resolve-via-default
log syslog debugging
#debug zebra nht detailed
#debug bgp updates
#debug bgp neighbor-events
#debug bgp nht
#allow-reserved-ranges
